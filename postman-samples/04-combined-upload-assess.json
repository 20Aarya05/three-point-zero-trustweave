            {
              "key": "userId",
              "value": "test-user-no-files",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{BASE_URL}}/api/trust/assess-with-upload",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "api",
            "trust",
            "assess-with-upload"
          ]
        }
      },
      "description": "Test combined endpoint with no files - should still perform assessment"
    }
  ]
